From 5a10427e4491641f7a37e8c004506f1d2671b10c Mon Sep 17 00:00:00 2001
From: Olivier Pantz <pantz@unice.fr>
Date: Wed, 9 Sep 2026 14:11:52 +0000
Subject: [PATCH] Pages: publish README and GUIDE as HTML (pandoc), link them
 from index.html

---
 .gitlab-ci.yml | 10 +++++++---
 docs/doc.css   | 14 ++++++++++++++
 index.html     |  4 ++--
 3 files changed, 23 insertions(+), 5 deletions(-)
 create mode 100644 docs/doc.css

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index 2238b5a..6bb42ef 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -1,11 +1,15 @@
 # GitLab Pages: publishes the repository as a static site
-# (on PLMlab: https://<login>.pages.math.cnrs.fr/transitionjs/)
+# (on PLMlab: https://<login>.pages.math.cnrs.fr/transitionjs/).
+# README.md and GUIDE.md are converted to HTML with pandoc, since Pages
+# serves Markdown files as plain text.
 pages:
   stage: deploy
-  image: alpine:latest
+  image: pandoc/core:latest
   script:
     - mkdir -p public
-    - cp -r index.html README.md GUIDE.md LICENSE transition.js transition.css tableofcontents.js graph.js themes examples docs public/
+    - cp -r index.html LICENSE transition.js transition.css tableofcontents.js graph.js themes examples docs public/
+    - pandoc README.md -s -f gfm -t html5 --metadata pagetitle="Transition.js" --metadata lang=en -c docs/doc.css -o public/readme.html
+    - pandoc GUIDE.md  -s -f gfm -t html5 --metadata pagetitle="Transition.js - guide" --metadata lang=fr -c docs/doc.css -o public/guide.html
   artifacts:
     paths:
       - public
diff --git a/docs/doc.css b/docs/doc.css
new file mode 100644
index 0000000..644943c
--- /dev/null
+++ b/docs/doc.css
@@ -0,0 +1,14 @@
+/* style of the HTML versions of README.md and GUIDE.md on the Pages site */
+body { font-family: "Latin Modern Sans", "Fira Sans", "Segoe UI", sans-serif; max-width: 50em; margin: 3em auto; padding: 0 1em; line-height: 1.55; color: #1a1a1a; }
+h1, h2, h3 { font-weight: normal; color: rgb(20%, 20%, 70%); }
+h1 { font-size: 2em; } h2 { margin-top: 2em; border-bottom: 1px solid #dde; }
+a { color: rgb(20%, 20%, 70%); }
+code { font-family: "Fira Mono", Menlo, Consolas, monospace; font-size: 0.9em; background: #f2f2f8; padding: 0.1em 0.3em; border-radius: 0.2em; }
+pre { background: #f2f2f8; padding: 0.8em 1em; overflow-x: auto; border-radius: 0.3em; }
+pre code { background: none; padding: 0; }
+table { border-collapse: collapse; margin: 1em 0; }
+th, td { border: 1px solid #dde; padding: 0.3em 0.7em; text-align: left; vertical-align: top; }
+th { background: #f2f2f8; font-weight: normal; }
+img { max-width: 100%; }
+#TOC { background: #f8f8fc; padding: 0.5em 1.5em; border-radius: 0.3em; margin: 1.5em 0; }
+#TOC ul { padding-left: 1.2em; }
diff --git a/index.html b/index.html
index c36865a..691ed34 100644
--- a/index.html
+++ b/index.html
@@ -27,8 +27,8 @@
   <p>Keys: Space, Enter, arrows, PageUp/PageDown, Home/End; Escape for the overview.</p>
   <h2>Documentation</h2>
   <ul>
-    <li><a href="README.md">README</a> — overview and beamer correspondence</li>
-    <li><a href="GUIDE.md">Guide</a> — the full reference (French)</li>
+    <li><a href="readme.html">README</a> — overview and beamer correspondence</li>
+    <li><a href="guide.html">Guide</a> — the full reference (French)</li>
   </ul>
 </body>
 </html>
-- 
2.43.0

